{
  "name": "cinebridge-notificacoes",
  "version": "1.0.0",
  "description": "CineBridge - microsserviço de e-mails, mensagens internas e alertas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrodevroot/atv4.git"
  },
  "keywords": [
    "cinebridge",
    "fastify",
    "rabbitmq",
    "microsservicos"
  ],
  "author": "pxdev__",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pedrodevroot/atv4/issues"
  },
  "homepage": "https://github.com/pedrodevroot/atv4#readme",
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "amqplib": "^2.4.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
