NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DB_HOST=recomendacoes-db
DB_PORT=5432
DB_USER=recomendacao
DB_PASSWORD=recomendacao
DB_NAME=cinebridge_recomendacao
DB_POOL_MAX=40
DB_TIMEOUT_MS=5000

RABBITMQ_HOST=cinebridge-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_RECONEXAO_MS=2000

WEB_CONCURRENCY=4
CACHE_TTL_MS=60000
CADASTRO_TIMEOUT_MS=15000

ARMAZENAMENTO_PROVEDOR=s3
PAGAMENTO_PROVEDOR=stripe
PROFISSIONAIS_PROVEDOR=interno
DECORADORES=cache,auditoria,compressao
CACHE_RECOMENDACOES_TTL_MS=60000
CACHE_RECOMENDACOES_MAXIMO=500
